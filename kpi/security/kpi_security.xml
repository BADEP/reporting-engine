<odoo>
    <record id="privilege_kpi" model="res.groups.privilege">
        <field name="name">Key Performance Indicators</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="group_kpi_manager" model="res.groups">
        <field name="name">Manage KPI's</field>
        <field name="privilege_id" ref="privilege_kpi"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
